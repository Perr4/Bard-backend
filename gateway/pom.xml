<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Il Gateway eredita direttamente dal parent di Spring Boot.
        Non cerca più il POM generale nella cartella superiore.
    -->
        <parent>
        <groupId>io.bard</groupId>
        <artifactId>bard-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- Coordinate Maven del Gateway -->
    <groupId>it.chronos</groupId>
    <artifactId>api-gateway</artifactId>

    <name>api-gateway</name>

    <description>
        API Gateway della piattaforma Chronos
    </description>

    <!--
        Queste versioni prima venivano ereditate
        dal POM generale chronos-platform.
    -->

    <dependencies>

        <!--
            Implementa il Gateway reattivo basato su Spring WebFlux.
            Riceve le richieste del frontend e le inoltra ai microservizi.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!--
            Permette al Gateway di registrarsi su Eureka
            e individuare gli altri microservizi tramite il loro nome.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!--
            Fornisce gli strumenti di Spring Security.
            Nel Gateway viene utilizzato per proteggere le rotte
            e gestire autenticazione e autorizzazione.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            Espone gli endpoint di monitoraggio,
            come /actuator/health e le metriche applicative.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- API pubbliche per leggere e verificare i token JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>

        <!-- Implementazione interna della libreria JJWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            Permette a JJWT di convertire in JSON
            i dati contenuti nel token.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Dipendenze generali per i test Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Strumenti specifici per testare Spring Security -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Strumenti per verificare applicazioni reattive WebFlux,
            incluso WebTestClient.
        -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!--
        Importa il catalogo delle versioni Spring Cloud.
        Maven potrà così individuare versioni compatibili
        di Gateway ed Eureka Client.
    -->

    <build>
        <plugins>

            <!-- Crea il file JAR eseguibile del Gateway -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
