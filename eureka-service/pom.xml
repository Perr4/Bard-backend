<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Eureka Server eredita direttamente dal parent di Spring Boot.
        Non cerca più il pom.xml generale nella cartella superiore.
    -->
        <parent>
        <groupId>io.bard</groupId>
        <artifactId>bard-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- Coordinate Maven del microservizio -->
    <groupId>it.chronos</groupId>
    <artifactId>eureka-server</artifactId>

    <name>eureka-server</name>
    <description>Server Eureka per la registrazione e la scoperta dei microservizi Chronos</description>

    <!-- Versioni precedentemente ereditate dal POM generale -->

    <dependencies>

        <!--
            Trasforma l'applicazione in un server Eureka.
            Gli altri microservizi potranno registrarsi qui.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>

        <!--
            Espone endpoint per controllare lo stato dell'applicazione,
            come /actuator/health.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Dipendenze necessarie per i test Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!--
        Importa il catalogo ufficiale delle versioni Spring Cloud.
        In questo modo Maven determina una versione di Eureka
        compatibile con Spring Boot 3.5.0.
    -->

    <build>
        <plugins>

            <!-- Crea il file JAR eseguibile di Eureka Server -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
